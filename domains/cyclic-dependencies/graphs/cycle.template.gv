strict digraph cycle {
    graph [layout = "fdp"; start = "7"; splines = "curved"; pad = "0.8,0.4"; outputorder = "edgesfirst";];
    graph [fontname = "Arial"; labelloc = "t"; bgcolor = "#F0F4F8";];
    node [fontname = "Arial"; style = "filled"; fontcolor = "#1A1A1A"; fontsize = 10; margin = "0.08,0.06";];
    edge [fontsize = 8; arrowsize = "0.5"; color = "#B0BEC5"; arrowcolor = "#B0BEC5";];

    subgraph cluster_package {
        label = "{{PACKAGE_LABEL}}";
        style = "filled,rounded";
        fillcolor = "#E8F4F8";
        color = "#01579B";
        penwidth = "2.5";
        labeljust = "c";
        fontname = "Arial";
        fontsize = 16;
        fontcolor = "#01579B";
        labelfontname = "Arial";
        labelfontsize = 16;
        {{PACKAGE_NODES}}
    }

    subgraph cluster_dependent {
        label = "{{DEPENDENT_LABEL}}";
        style = "filled,rounded";
        fillcolor = "#F8E8F4";
        color = "#6A1B9A";
        penwidth = "2.5";
        labeljust = "c";
        fontname = "Arial";
        fontsize = 16;
        fontcolor = "#6A1B9A";
        labelfontname = "Arial";
        labelfontsize = 16;
        {{DEPENDENT_NODES}}
    }

    {{EDGES}}
}
